[core]
	excludesfile = ~/.gitignore_global
	; Use the system pager so a clean Mac does not require delta.
	pager = less -FRX
[user]
	name = tomitamasa
	email = 41310325+tomitamasa@users.noreply.github.com
[init]
	defaultBranch = main
[pull]
	rebase = false
[ghq]
	root = ~/src
[delta]
	navigate = true
	line-numbers = true
[diff]
	colorMoved = default
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
