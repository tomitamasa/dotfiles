<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>jp.hiroshiba.voicevox-engine</string>

  <!-- VOICEVOX.app に同梱されているエンジン本体を GUI 抜きで常駐させる。
       Claude Code の通知フック (~/.claude/hooks/voicevox-notify.sh) の
       フォールバック先。AivisSpeech が落ちているときここに降りる。
       常駐していないと macOS の say -v Kyoko まで落ちてしまう。 -->
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/VOICEVOX.app/Contents/Resources/vv-engine/run</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>50021</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Applications/VOICEVOX.app/Contents/Resources/vv-engine</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/voicevox-engine.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/voicevox-engine.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>VV_OUTPUT_LOG_UTF8</key>
    <string>1</string>
  </dict>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
